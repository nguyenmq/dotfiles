[user]
    name = {{fullname}}
    email = {{email}}
[core]
    editor = nvim
    pager = less -S
    filemode = false
    preloadIndex = true
    compression = 9
[merge]
    tool = nvimdiff
    guitool = gvimdiff
[diff]
    tool = nvimdiff
    guitool = gvimdiff
[color]
    ui = true
[format]
    pretty = %C(bold magenta)%h%C(reset) - %C(bold blue)%an%C(reset) - %C(bold green)%aD%C(reset) %C(reset)%C(bold yellow)%d%C(reset)%n          %C(black)%s%C(reset)%C(reset)
[alias]
    lg1 = log --graph --abbrev-commit --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
    lg = log --graph --abbrev-commit --all
    lgm = log --graph --abbrev-commit HEAD origin/mainline
    lb = log --graph --abbrev-commit HEAD
    ln = log --graph --abbrev-commit --all -20
    lbm = log --graph --abbrev-commit -20 HEAD origin/mainline
    lbb = log --graph --abbrev-commit -20 HEAD
    dt = difftool
    su = submodule update --init --recursive
    ls = status --no-short --untracked-files=normal
    df = diff --no-color
    d1 = difftool HEAD~1 HEAD
    d2 = difftool HEAD~2 HEAD
    d3 = difftool HEAD~3 HEAD
    sh = show --no-color --format=medium
    shn = show --no-color --name-only --format=medium
[credential]
    helper = cache
[color "diff"]
    commit = green bold
    meta = blue bold
    frag = magenta bold
    old = red
    new = green
[color "status"]
    changed = green bold
    added = blue bold
    untracked = magenta
    deleted = red bold
    header = cyan
[difftool]
    prompt = true
[grep]
    lineNumber = true
[fetch]
    prune = true
[pager]
    show = "nvim -R -c PAGER -c 'set filetype=git' -c 'normal gg' -"
    diff = "nvim -R -c PAGER -c 'set filetype=git' -c 'normal gg' -"
[status]
    branch = true
    short = true
    showUntrackedFiles = all
    submoduleSummary = true
[push]
    default = simple
[pull]
    ff = only
[rerere]
    enabled = true
    autoUpdate = true
[commit]
    verbose = true
[branch]
    sort = -committerdate
[tag]
    sort = -version:refname
[column]
    ui = auto
    status = never
[log]
    decorate = true
