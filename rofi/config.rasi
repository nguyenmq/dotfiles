configuration {
    cycle:               true;
    display-audio:       "󰓃";
    display-clipboard:   "󰅇";
    display-drun:        "󰏋";
    display-emoji:       "󰱨";
    display-filebrowser: "󰉋";
    display-packages:    "";
    display-run:         "󰆍";
    display-window:      "󰣆";
    drun-display-format: "{name}";
    hide-scrollbar:      true;
    icon-theme:          "Numix";
    kb-mode-complete:    "";
    kb-mode-next:        "Control+N";
    kb-mode-previous:    "Control+P";
    kb-row-down:         "Control+n";
    kb-row-up:           "Control+p";
    m:                   "-4";
    modi:                "{{rofi_modi}}";
    sidebar-mode:        false;
    sort:                true;
    window-format:       "{c} · {t}";
    window-thumbnail:    true;
}

@theme "olive"
